  - effectID: POSTERIZE
    docURL: 
    customMessages:
    - message: "*No visible change on pure white text.\nTint the text or add a color effect first."
      keywords: []
  - effectID: GREYSCALE
    docURL: 
    customMessages:
    - message: "*White text is already greyscale. Only Greyscale Tint\nand a negative Luminosity change it."
      keywords: []
  - effectID: COLOR_RAMP
    docURL: 
    customMessages:
    - message: "*Pure white text takes the ramp's end color.\nTint the text or add a color effect first for a gradient."
      keywords: []
  - effectID: COLOR_GRADING
    docURL: 
    customMessages:
    - message: "*Pure white text only gets the Light Color Tint.\nTint the text or add a color effect first."
      keywords: []
