  m_Name: 
  m_EditorClassIdentifier: 
  tweens: []
  rectTransform: {fileID: 972655526}
  materialConfigurators:
  - {fileID: 1305028570}
  - {fileID: 1073586378}
  typewriters:
  - {fileID: 1305028569}
  - {fileID: 1073586377}
  moveAwayOnHide: 0
  drawGizmos: 0
  demoName: Visual Novel
  demoDescription: '<b>Showcases:</b> A romance typewriter: petal reveal, drift away
    hide, word tags

    <size=45%> </size>

    Letters drift in like petals (Fade,
    Offset, Initial Rotation, Scale) and the old line drifts off word by word before
    the next one types. Tags make single words float, sway or beat like a heart.
    The text colour is TMP''s vertex colour, so colour tags replace it instead of
    darkening it. The falling petals are a particle emitter with sway, spin and Flutter.

    <size=45%>
    </size>

    <size=88%><color=#a9b6cf>Intermediate setup: 2 texts and 1 particle
    emitter; the dialogue flow is code. The characters and box are demo art.</color></size>'
  postprocessConfigSO: {fileID: 11400000, guid: 956b61899a5138342a39eb6f6e55d5c9, type: 2}
  camerasConfiguration: {fileID: 11400000, guid: 85d88584f784ea74496504b2bb2a74cd, type: 2}
  body: {fileID: 1305028569}
  speaker: {fileID: 1073586377}
  nameTag: {fileID: 606780708}
  nameTagX:
  - -300
  - 300
  sidePortraits:
  - {fileID: 1827397062}
  - {fileID: 393586959}
  portraits:
  - {fileID: 21300000, guid: e23acae3fb0a2494facbac8f4b9ddbc2, type: 3}
  - {fileID: 21300000, guid: e1a588369e8ffbb45b486c1e2416b5c0, type: 3}
  - {fileID: 21300000, guid: da829fc7ae07f874cb6b5161007fc62f, type: 3}
  - {fileID: 21300000, guid: 5d259ac2bd2cd8e4faffc336df9ec5d4, type: 3}
  - {fileID: 21300000, guid: 34ab8204ccc4c4c44854f1f6359a0cc4, type: 3}
  - {fileID: 21300000, guid: eea07185a871ae149b7c0c2a20d26eca, type: 3}
  - {fileID: 21300000, guid: c777185eede3e294a978badffb7337cc, type: 3}
  - {fileID: 21300000, guid: bf13d1a30bd608e43a35a1ca3b2bdcf9, type: 3}
  - {fileID: 21300000, guid: 1e18c1bee30f14a49aa59ee9f5309291, type: 3}
  - {fileID: 21300000, guid: 9ec71c0d4eac816418020f27c63bd38c, type: 3}
  - {fileID: 21300000, guid: 7a6a0917749a15e4e895b26c43fe0ab6, type: 3}
  - {fileID: 21300000, guid: d7429c55f7e1a7544b599b265f0183e7, type: 3}
  - {fileID: 21300000, guid: f1dfd6348e3d3ac45bd69ba6904728ad, type: 3}
  - {fileID: 21300000, guid: 829579540787cda4f89412f3495c976f, type: 3}
  - {fileID: 21300000, guid: 7803fcea5a539194d91ddf839063669e, type: 3}
  - {fileID: 21300000, guid: 7f71afef883a684418d75de1b3d7229f, type: 3}
  - {fileID: 21300000, guid: 093941e1248b80e4f9b27d457aacfb79, type: 3}
  - {fileID: 21300000, guid: 0e8365c0f5cc289499fac177192abed4, type: 3}
  - {fileID: 21300000, guid: bf2cd5a16c5a17e44ae113c88824adce, type: 3}
  - {fileID: 21300000, guid: 2cad753b4cc89b149acf64a9ce9403b7, type: 3}
  - {fileID: 21300000, guid: e6b4ea7cff91f804c92b01753ea89820, type: 3}
  listenerColor: {r: 0.45, g: 0.45, b: 0.5, a: 1}
  speakerScale: 1.05
  listenerScale: 0.95
  portraitScaleTime: 0.15
  nextIndicator: {fileID: 2036387857}
  indicatorBlink: 0
  popOnLine: {fileID: 0}
  hideBetweenLines: 1
  hideTimeout: 1.2
  talking: {fileID: 0}
  talkingIdleAlpha: 0.25
  lines:
  - speaker: Hana
    text: Look, Ren... the cherry blossoms are <color=#e2477f><verticalMovement;height:6;speed:1.1>dancing</></color>
      just for us.
    side: 1
    portrait: 19
    hold: 2.2
  - speaker: Ren
    text: F-for us? I mean... yeah. They're really <color=#e2477f><pendulum;from:-12;to:12;speed:0.9>pretty</></color>.
    side: 0
    portrait: 5
    hold: 2
  - speaker: Hana
    text: Was that about the flowers? My <color=#e2477f><scale;from:1;to:1.15;speed:2.6>heart</></color>
      won't stop racing...
    side: 1
    portrait: 11
    hold: 2.2
  - speaker: Ren
    text: Then stay a little longer. Let's watch them <color=#e2477f><verticalMovement;height:5;speed:0.8>fall</></color>
      together.
    side: 0
    portrait: 1
    hold: 2.4
  fadeInDuration: 0.3
  fadeOutDuration: 0.35
  hiddenScale: 0.85
