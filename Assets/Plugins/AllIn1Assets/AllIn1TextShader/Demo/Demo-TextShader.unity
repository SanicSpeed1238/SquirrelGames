--- !u!114 &1402350871
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1402350870}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a4356cc914907645b95813d5e8005ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tweens: []
  rectTransform: {fileID: 1402350872}
  materialConfigurators:
  - {fileID: 553515692}
  - {fileID: 1687432378}
  - {fileID: 1679185717}
  typewriters:
  - {fileID: 553515691}
  - {fileID: 1687432377}
  - {fileID: 1679185711}
  moveAwayOnHide: 0
  drawGizmos: 0
  demoName: RPG Dialogue
  demoDescription: '<b>Showcases:</b> A 16 bit typewriter: instant letters, per letter
    tags

    <size=45%> </size>

    A pixel font with a hard Drop Shadow, and a
    reveal of one Fade at speed 60, so each letter pops in with no motion and lines
    swap at once. A Shake tag on every letter lets each one tremble on its own; Rainbow
    and Swing tags animate whole words.

    <size=45%> </size>

    <size=88%><color=#a9b6cf>Intermediate
    setup: 3 texts; the dialogue flow is code. The window is a demo sprite.</color></size>'
  postprocessConfigSO: {fileID: 11400000, guid: dea25b2842cfb6243b63357ef3b8c68c, type: 2}
  camerasConfiguration: {fileID: 11400000, guid: 85d88584f784ea74496504b2bb2a74cd, type: 2}
  body: {fileID: 553515691}
  speaker: {fileID: 1687432377}
  nameTag: {fileID: 0}
  nameTagX: []
  sidePortraits: []
  portraits: []
  listenerColor: {r: 0.45, g: 0.45, b: 0.5, a: 1}
  speakerScale: 1.05
  listenerScale: 0.95
  portraitScaleTime: 0.15
  nextIndicator: {fileID: 1679185713}
  indicatorBlink: 0.8
  popOnLine: {fileID: 0}
  hideBetweenLines: 0
  hideTimeout: 1.2
  talking: {fileID: 0}
  talkingIdleAlpha: 0.25
  lines:
  - speaker: SAGE
    text: '* Ah... a traveler. Forgive an old man, but the roads are not safe. The
      kingdom has fallen into <shake;length:2.5>D</><shake;length:2.5>A</><shake;length:2.5>R</><shake;length:2.5>K</><shake;length:2.5>N</><shake;length:2.5>E</><shake;length:2.5>S</><shake;length:2.5>S</>.'
    side: 0
    portrait: -1
    hold: 2.6
  - speaker: SAGE
    text: '* Only the <rainbow;speed:8>CRYSTAL SWORD</> can break the curse.'
    side: 0
    portrait: -1
    hold: 2
  - speaker: SAGE
    text: '* It rests atop the <color=#8fd8ff><swing;amount:5;speed:2.5>Tower of
      Winds</></color>, beyond the marsh.'
    side: 0
    portrait: -1
    hold: 2
  - speaker: SAGE
    text: '* Beware, hero... the <color=#ff7070><shake;length:3>E</><shake;length:3>N</><shake;length:3>E</><shake;length:3>M</><shake;length:3>Y</></color>
      still waits in the dark.'
    side: 0
    portrait: -1
    hold: 2.4
  fadeInDuration: 0.3
  fadeOutDuration: 0.35
  hiddenScale: 0.85
