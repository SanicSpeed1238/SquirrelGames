  demoName: Spline Travel
  demoDescription: '<b>Showcases:</b> Show and Hide travel along splines

    <size=45%>
    </size>

    Show() flies each word in along its curve and Hide() sends it off
    the other end. The travel is the reveal, so the words need no reveal effect at
    all.

    <size=45%> </size>

    <size=88%><color=#a9b6cf>Intermediate setup:
    3 texts. A demo script times Show and Hide; the dotted routes are sprites.</color></size>'
  postprocessConfigSO: {fileID: 11400000, guid: 2ad0a792dd3870d49aa05ef29ce7d698, type: 2}
  camerasConfiguration: {fileID: 11400000, guid: 85d88584f784ea74496504b2bb2a74cd, type: 2}
  steps:
  - spline: {fileID: 1264259887}
    typewriter: {fileID: 0}
    fader: {fileID: 0}
    showAt: 0.15
    hideAt: 3.95
  - spline: {fileID: 1480049705}
    typewriter: {fileID: 0}
    fader: {fileID: 0}
    showAt: 0.4
    hideAt: 3.7
  - spline: {fileID: 276695401}
    typewriter: {fileID: 0}
    fader: {fileID: 0}
    showAt: 0.9
    hideAt: 3.45
  loopLength: 4.9
  fadeInOnShow:
  - {fileID: 221025501}
  fadeOnHide:
  - {fileID: 221025501}
