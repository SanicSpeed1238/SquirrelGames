  - {fileID: 892009571}
  - {fileID: 161757598}
  - {fileID: 384437331}
  moveAwayOnHide: 0
  drawGizmos: 0
  demoName: Color Gradient
  demoDescription: '<b>Showcases:</b> Color Gradient scopes and scrolling

    <size=45%>
    </size>

    Rect scope spans the whole line (the sunset), Character scope repeats
    on every letter (the aqua), and a tiling ramp with Speed scrolls through the
    text. SPLASH ripples like water through the Warp UV effect; its outline and depth
    ripple with it, and Text Particles throw water drops off it, a spray from the
    letter tops and drips from the bottoms, each drop a colour from the same gradient.

    <size=45%>
    </size>

    <size=88%><color=#a9b6cf>Simple setup: 3 texts and 2 particle emitters,
    no code.</color></size>'
  postprocessConfigSO: {fileID: 11400000, guid: 2753d8977bab46443b29ddee00ca92e5, type: 2}
  camerasConfiguration: {fileID: 11400000, guid: 85d88584f784ea74496504b2bb2a74cd, type: 2}
  steps:
