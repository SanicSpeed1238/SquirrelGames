    showAt: 0.3
    hideAt: -1
  - spline: {fileID: 0}
    typewriter: {fileID: 848426796}
    fader: {fileID: 0}
    showAt: 1.4
    hideAt: -1
  loopLength: 100000
  fadeInOnShow: []
  fadeOnHide: []
