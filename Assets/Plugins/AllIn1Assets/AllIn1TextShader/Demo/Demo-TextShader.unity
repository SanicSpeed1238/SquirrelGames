  m_Script: {fileID: 11500000, guid: 944ba26fbfd0e0643b9ae91071b682d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tweens: []
  rectTransform: {fileID: 2121908332}
  materialConfigurators:
  - {fileID: 1805573372}
  - {fileID: 381127447}
  typewriters:
  - {fileID: 1805573371}
  - {fileID: 381127446}
  moveAwayOnHide: 0
  drawGizmos: 0
  demoName: Portal
  demoDescription: '<b>Showcases:</b> The Twist UV effect, animated by events

    <size=45%>
    </size>

    Twist swirls the whole word around the middle of its rect. Driving
    its amount from strong to zero as the title reveals makes the letters unwind
    out of the vortex; driving it back up as it hides sucks them back in. Twist peaks
    at 1.57 (the shader takes the sine).

    <size=45%> </size>

    <size=88%><color=#a9b6cf>Intermediate
    setup: 2 texts. A small demo script eases the Twist amount from the typewriter''s
    reveal and hide events; the vortex is a demo sprite.</color></size>'
  postprocessConfigSO: {fileID: 11400000, guid: 76d6b20eab932064c91f72a181458c79, type: 2}
  camerasConfiguration: {fileID: 11400000, guid: 85d88584f784ea74496504b2bb2a74cd, type: 2}
  steps:
  - spline: {fileID: 0}
    typewriter: {fileID: 1805573371}
    fader: {fileID: 0}
    showAt: 0.05
    hideAt: -1
  - spline: {fileID: 0}
    typewriter: {fileID: 381127446}
    fader: {fileID: 0}
    showAt: 1
    hideAt: -1
  loopLength: 100000
  fadeInOnShow: []
  fadeOnHide: []
