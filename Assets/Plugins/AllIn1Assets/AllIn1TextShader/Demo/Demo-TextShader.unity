  lines:
  - speaker: CMDR. VEGA
    text: Ranger, do you copy? We've lost all contact with <slide;length:5;speed:9>Outpost
      9</>.
    side: 0
    portrait: -1
    hold: 2
  - speaker: CMDR. VEGA
    text: Long range scans show <color=#ff5a3c><offset;from:[0,0];to:[4,0];speed:14>hostile
      signatures</></color> closing on your position.
    side: 0
    portrait: -1
    hold: 2
  - speaker: CMDR. VEGA
    text: Get to the evac point, now. The signal is <dangle;length:12;speed:5>breaking
      up</>...
    side: 0
    portrait: -1
    hold: 2
  - speaker: CMDR. VEGA
    text: Vega out. <color=#ffe7b0><slide;length:3;speed:4>Good hunting</></color>,
      Ranger.
    side: 0
    portrait: -1
    hold: 2.4
  fadeInDuration: 0.3
  fadeOutDuration: 0.35
  hiddenScale: 0.85
