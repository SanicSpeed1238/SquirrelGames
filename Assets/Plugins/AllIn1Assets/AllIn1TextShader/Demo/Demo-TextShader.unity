  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3f5e7f469614a0e44bedb4156b75737b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tweens: []
  rectTransform: {fileID: 821168804}
  materialConfigurators:
  - {fileID: 2028665059}
  typewriters:
  - {fileID: 2028665057}
  moveAwayOnHide: 0
  drawGizmos: 0
  demoName: Comic
  demoDescription: '<b>Showcases:</b> Comic lettering: halftone dots from an Overlay
    Texture

    <size=45%> </size>

    The dots are a tiling texture whose dots
    grow toward the bottom, laid over the word in rect space and multiplied over
    a yellow to red gradient. A thick ink outline and a solid black Extrude give
    the printed look; a Warp makes the word grow toward the bang. Letters slam in
    oversized, throb in a loop and blow outward on the way out.

    <size=45%> </size>

    <size=88%><color=#a9b6cf>Simple
    setup: 1 text, no code. The burst and the panel are demo art, popped in by the
    text''s reveal events.</color></size>'
  postprocessConfigSO: {fileID: 11400000, guid: c31a80a994212cc4c8880ced10a47627, type: 2}
  camerasConfiguration: {fileID: 11400000, guid: 85d88584f784ea74496504b2bb2a74cd, type: 2}
