MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1171343563}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 944ba26fbfd0e0643b9ae91071b682d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tweens: []
  rectTransform: {fileID: 1171343564}
  materialConfigurators:
  - {fileID: 1134726997}
  - {fileID: 254670285}
  - {fileID: 896607865}
  - {fileID: 2039548864}
  typewriters:
  - {fileID: 1134726996}
  - {fileID: 254670284}
  - {fileID: 896607864}
  - {fileID: 2039548863}
  moveAwayOnHide: 0
  drawGizmos: 0
  demoName: Notebook
  demoDescription: '<b>Showcases:</b> Hand Drawn, underline, strikethrough and mark,
    Vertex Shake, Alpha Cutoff

    <size=45%> </size>

    Hand Drawn redraws each
    letter''s ink in small steps, out of sync with its neighbours, so the writing
    boils like a pencil animation. The lines are TMP''s own underline, strikethrough
    and mark tags, drawn by the shader, so they appear with their letters as the
    pen writes. Vertex Shake nudges the arrow, and the stamp''s worn ink is a Fade
    texture made crisp by Alpha Cutoff.

    <size=45%> </size>

    <size=88%><color=#a9b6cf>Simple
    setup: 4 texts and rich text tags, no code for the text. The page and the stamp''s
    border are demo sprites; a demo script times the entrances.</color></size>'
  postprocessConfigSO: {fileID: 11400000, guid: 716ba1433b165c649ba6fbb678873267, type: 2}
  camerasConfiguration: {fileID: 11400000, guid: 85d88584f784ea74496504b2bb2a74cd, type: 2}
  steps:
  - spline: {fileID: 0}
    typewriter: {fileID: 1134726996}
    fader: {fileID: 0}
    showAt: 0.35
    hideAt: -1
  - spline: {fileID: 0}
    typewriter: {fileID: 254670284}
    fader: {fileID: 0}
    showAt: 1.15
    hideAt: -1
  - spline: {fileID: 0}
    typewriter: {fileID: 896607864}
    fader: {fileID: 0}
    showAt: 3.5
    hideAt: -1
  - spline: {fileID: 0}
    typewriter: {fileID: 2039548863}
    fader: {fileID: 0}
    showAt: 4
    hideAt: -1
  loopLength: 100000
  fadeInOnShow: []
  fadeOnHide: []
