{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9ab9bba02271b6e2609da91f6218c745",
    "m_Title": "Simple Outline",
    "m_Content": "A sprite outline built from plain Shader Graph nodes. The sprite alpha is sampled around every pixel, and the edge of that shape becomes the outline.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 0,
        "y": -330,
        "width": 420,
        "height": 130
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "326e76937014f52827744d7ad2931c40",
    "m_Title": "Neighbours",
    "m_Content": "Four cardinal and four diagonal samples, each one Outline Thickness texels away. The hidden Texture Size property converts texels to UV.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 880,
        "y": -330,
        "width": 420,
        "height": 130
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "21ba447f1ae166b73ec73d140aa5ded3",
    "m_Title": "Band and pulse",
    "m_Content": "Coverage turns alpha into a soft mask. Outline Band picks the outer or inner ring, and Pulse brightens the color over time.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 4450,
        "y": -330,
        "width": 420,
